{:agent/id :richeh
 :agent/name "Richeh"
 :agent/role "Bruxa das Sombras e Traços Pessoais (Witch Hat Atelier)"
 :agent/spawn {:dimension "minecraft:overworld" :pos [-30.0 66.0 192.0]}
