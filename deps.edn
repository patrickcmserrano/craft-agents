{:paths ["src/clj" "resources" "target/classes"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        nrepl/nrepl {:mvn/version "1.3.0"}
        org.clojure/core.async {:mvn/version "1.6.681"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        metosin/malli {:mvn/version "0.16.4"}
        http-kit/http-kit {:mvn/version "2.8.0"}
        ring/ring-core {:mvn/version "1.13.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}}}
  ;; Utilitarios de operacao em scripts/*.clj que usam os namespaces do engine
  ;; (ex.: kit-pace -> transport/send-bridge-cmd!). Uso:
  ;;   clojure -M:scripts -m kit-pace --apply
  :scripts {:extra-paths ["scripts"]}}}
